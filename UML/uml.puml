@startuml
skinparam classAttributeIconSize 0
hide methods

enum Role {
 ADMIN
 EMPLOYEE
 CLIENT
}

enum OrderStatus {
 PENDING_QUOTE
 QUOTED
 APPROVED
 IN_PRODUCTION
 FINISHED
 DELIVERED
 CANCELED
}

enum AddressType {
 RESIDENTIAL
 COMMERCIAL
}

enum MaterialType {
 PLA
 ABS
 PETG
 TPU
 RESIN
}

class users {
 + id : UUID
 + name : String
 + surname : String
 + cpf : String <<unique>>
 + email : String <<unique>>
 + password_hash : String
 + phone : String
 + role : Role
 + created_at : LocalDateTime
 + updated_at : LocalDateTime
 + deleted_at : LocalDateTime
}

class addresses {
 + id : UUID
 + user_id : UUID <<FK>>
 + zip_code : String
 + street : String
 + number : String
 + complement : String
 + neighborhood : String
 + city : String
 + state : String
 + address_type : AddressType
 + is_main : Boolean
}

class materials {
 + id : UUID
 + name : String
 + type : MaterialType
 + price_per_kg : BigDecimal
 + active : Boolean
}

class printers {
 + id : UUID
 + name : String
 + model : String
 + power_watts : Integer
 + cost_per_hour : BigDecimal
 + active : Boolean
}

class services {
 + id : UUID
 + name : String
 + description : String
 + price_per_hour : BigDecimal
 + active : Boolean
}

class energy_tariffs {
 + id : UUID
 + price_per_kwh : BigDecimal
 + valid_from : LocalDate
}

class orders {
 + id : UUID
 + title : String
 + description : String
 + status : OrderStatus
 + client_id : UUID <<FK users>>
 + employee_id : UUID <<FK users, nullable>>
 + delivery_address_id : UUID <<FK>>
 + energy_tariff_id : UUID <<FK>>
 + total_amount : BigDecimal
 + deadline : LocalDate
 + created_at : LocalDateTime
 + updated_at : LocalDateTime
}

class order_items {
 + id : UUID
 + order_id : UUID <<FK>>
 + material_id : UUID <<FK>>
 + printer_id : UUID <<FK>>
 + description : String
 + model_url : String
 + weight_grams : BigDecimal
 + print_time : Integer
 + material_cost : BigDecimal
 + energy_cost : BigDecimal
 + printer_cost : BigDecimal
 + subtotal : BigDecimal
}

class order_services {
 + id : UUID
 + order_id : UUID <<FK>>
 + service_id : UUID <<FK>>
 + hours : BigDecimal
 + price_per_hour : BigDecimal
 + subtotal : BigDecimal
}

' Endereços do usuário
users "1" -- "0..*" addresses : user_id

' Cliente e funcionário do pedido
users "1" -- "0..*" orders : client_id
users "0..1" -- "0..*" orders : employee_id

' Endereço de entrega e tarifa usada no pedido
addresses "1" -- "0..*" orders : delivery_address_id
energy_tariffs "1" -- "0..*" orders : energy_tariff_id

' Itens impressos do pedido
orders "1" -- "1..*" order_items : order_id
materials "1" -- "0..*" order_items : material_id
printers "1" -- "0..*" order_items : printer_id

' Serviços extras do pedido
orders "1" -- "0..*" order_services : order_id
services "1" -- "0..*" order_services : service_id
@enduml
